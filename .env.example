# Copy to .env.local (git ignores it; never commit keys). Read by the local
# API (`pnpm dev`) and `pnpm preview`. Keys stay on your machine and never
# reach the browser.

# How the API calls Mathpix and Claude:
#   recorded  replay saved responses only (new handwriting is not read)
#   record    call the service for anything new and save the answer under
#             .local/recordings/, so redrawing the same strokes is free
#   live      always call the service
PROVIDERS=record

# Handwriting recognition (required to test the board): https://mathpix.com/docs/convert/overview
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# Optional: organize handouts with Claude instead of the built-in rules.
ANTHROPIC_API_KEY=

# Optional: where TeX Live is, if not in the default place
# (C:\texlive\2026\bin\windows on Windows, /opt/texlive/2026/bin/x86_64-linux on Linux).
# TEXLIVE_BIN=
