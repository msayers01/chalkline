{
  "name": "chalkline",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:snap": "turbo run test:snap --",
    "compile-matrix": "pnpm --filter @chalkline/compile-matrix run matrix"
  },
  "devDependencies": {
    "@chalkline/eslint-plugin": "workspace:*",
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.19.2",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.11.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
